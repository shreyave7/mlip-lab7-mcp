# Synthetic class scenario. Keep this value for the core lab.
LAB_NOW=2026-10-18T21:10:00+00:00

# Optional: any LLM with tool calling, through its OpenAI-compatible API.
# Leave LLM_MODEL blank to run without a model. Never commit .env.
#
# Gemini (course credits): keep the base URL below, e.g. LLM_MODEL=gemini-3-flash-preview
# OpenAI:                  leave LLM_BASE_URL blank
# Ollama (local, free):    LLM_BASE_URL=http://localhost:11434/v1 and LLM_API_KEY=ollama
# Others (OpenRouter, Groq, vLLM, ...): use the provider's OpenAI-compatible URL
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
LLM_API_KEY=
